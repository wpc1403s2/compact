# ── LLM 提供商配置 ──────────────────────────────────────────
# LLM_PROVIDER: 选择使用哪家大模型
#   auto      - 按 CONTRACT_LLM → MINIMAX → OPENAI 顺序自动选择第一个有效 key
#   contract  - 通用 OpenAI 兼容端点（通义千问、DeepSeek、智谱、本地 vLLM 等）
#   minimax   - MiniMax 官方
#   openai    - OpenAI 官方
LLM_PROVIDER=contract

# 通用 OpenAI 兼容端点（默认指向阿里通义千问 DashScope；换成 DeepSeek 等只需改 BASE_URL 和 MODEL）
#CONTRACT_LLM_API_KEY=sk-c7793b13dc54417ba7a1920f0a49526e
#CONTRACT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#CONTRACT_LLM_MODEL=qwen3.8-max-0902
#CONTRACT_LLM_MODEL=deepseek-v4.1-flash（无效模型名，有效值为 deepseek-flash / deepseek-v4-pro）

CONTRACT_LLM_API_KEY=sk-cb25918274f94041a507160a56d27f6e
CONTRACT_LLM_BASE_URL=https://api.deepseek.com/v1
CONTRACT_LLM_MODEL=deepseek-flash
# DeepSeek 示例：
# CONTRACT_LLM_BASE_URL="https://api.deepseek.com/v1"
# CONTRACT_LLM_MODEL="deepseek-chat"
# 智谱示例：
# CONTRACT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CONTRACT_LLM_MODEL=glm-4-plus

# MiniMax
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.7

# OpenAI 官方
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM 调用参数（所有 provider 共用）
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30
LLM_MAX_RETRIES=0

# ── 应用基础配置 ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text  # text / json

# ── 向量数据库 ──────────────────────────────────────────────
VECTOR_DB_TYPE=faiss
EMBEDDING_MODEL=shibing624/text2vec-base-chinese
FAISS_INDEX_PATH=data/faiss_index

# ── 数据库 ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/contract_review
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/contract_review
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 首次启动时若 users 表为空，自动注入 data/seed.sql 中的默认账号（admin/admin123）
SEED_ON_STARTUP=true

# ── Celery / Redis ─────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ── 安全 ───────────────────────────────────────────────────
CORS_ORIGINS=*  # 逗号分隔域名列表，"*" 表示允许所有（生产环境必须修改）
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=20
JWT_SECRET_KEY=dev-secret-change-in-production  # 生产环境必须修改为强密钥

# ── 熔断配置 ───────────────────────────────────────────────
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=60

# ── OpenTelemetry（可选）──────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=contract-review
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
